{
  "services": {
    "api": {
      "root": "api",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "installCommand": "pip install -r ../../../requirements.txt",
      "buildCommand": "bash probe_build.sh"
    },
    "storefront": { "root": "storefront-web", "framework": "nextjs" },
    "portal": { "root": "merchant-web", "framework": "nextjs" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/portal(.*)", "destination": { "service": "portal" } },
    { "source": "/(.*)", "destination": { "service": "storefront" } }
  ]
}
